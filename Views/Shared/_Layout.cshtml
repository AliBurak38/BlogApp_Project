<!DOCTYPE html>
<html lang="en">

    <head>
<meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="/lib/bootstrap/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href=" /css/style.css"/>
        <title>Document</title>
        
    </head>
   
        <body>

            <nav class="navbar navbar-expand-lg bg-white shadow-sm ">

                <div class="container">

                    <a href="/posts"class="navbar-brand">

                <i class="bi bi-code-square"></i> BlogApp
                    
                    </a>

                 <ul class="navbar-nav ms-auto">

                     @if(User.Identity!.IsAuthenticated)
                     {
                       <li class="nav-item">

                        <a href="/Posts/List" class="nav-link">Postlarım</a>

                      </li>
                        <li class="nav-item">

                         <a href="#" class="nav-link">@User.Identity.Name</a>

                          </li>
                          <li class="nav-item">

                         <a href="/users/Logout" class="nav-link">Çıkış yap</a>

                         </li>
                    


                     }
                   else
                   {
                         <li class="nav-item">

                        <a href="/users/Login" class="nav-link">Giriş yap</a>

                        </li>
                      <li class="nav-item">

                        <a href="/users/Register" class="nav-link">Kayıt Ol</a>

                     </li>


                    }

                 </ul>
                  
                </div>


            </nav>
            <div class="container mt-3">

             @RenderBody()

            </div>

         @RenderSection("Scripts", required: false)


        </body>



</html>