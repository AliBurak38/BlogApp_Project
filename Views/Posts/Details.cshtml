@using NewBlogApp.Entitiy

@model Post

@{
    Layout = "_Layout";
}



<div class="row">

    <div class="col-lg-8">

        <div class="bg-white p-4">

            <h1 class="h4 mb-4">@Model.Title</h1>

            <div class="tags">

                @foreach (var item in Model.Tags)
                {

                    <a href="/Posts/Tag/@item.Url" class="badge bg-@item.Color bg-opacity-10 text-@item.Color mb-2 fw-bold">@item.Text</a>


                }

            </div>




            <img src="~/img/@Model.Image" class="img-fluid rounded" alt="" />

            <ul class="list-inline my-3">

                <li class="list-inline-item"><i class="bi bi-calendar-event" > Yayın Tarihi: @Model.PublishedOn.ToString("d")</i></li>
                <li class="list-inline-item"><i class="bi bi-file-person"> <a href="/profile/@Model.User.UserName"> Yayımlayan: @Model.User.UserName</a></i></li>

            </ul>
            <hr class="py-3" />
            <div>@Model.Content</div>
        </div>

    </div>

    <div class="bg-white mt-3">
        <div class="card border-0">
            <div class="card-header pb-0">

                <h4>@Model.Comments.Count() adet yorum </h4>


            </div>
            <div class="card-body">
                <div id="comments">
                    @foreach(var com in Model.Comments)
                    {

                        <div class="my-4 d-flex">

                            <img src="/img/@com.User.Image" alt="" class="avatar rounded-circle float-start me-3" >

                            <div>

                                <div class="mb-2 d-flex">

                                    <h6 class="me-2"><a href="/profile/@com.User.UserName">@com.User.UserName</a></h6>
                                    <small>@com.PublishedOn.ToString("G")</small>

                                </div>
                                <p>@com.Text</p>

                            </div>




                        </div>




                    }
                </div>
                @if (User.Identity!.IsAuthenticated)
                { 
                
                    <hr class=" my-4" />
              <div >

                  <h4>Yorum Yap</h4>
                    <form action="/Posts/AddComment" method="post" >
                        
                    <input type="hidden"  id="PostId"name="PostId" value="@Model.PostId" />
                    
                        <div class="mb-3">

                            <label for="Text" class="form-label">Yorum</label>
                            <textarea type="text" name="Text" id="Text"  rows="3" class="form-control" ></textarea>

                        </div>
                        <div class="mb-3">

                            <button  id="BtnYorumKayit" class="btn btn-primary" type="submit">Kaydet</button>


                        </div>
                        
                    </form>

              </div>
                
                
                }
                else
                {

                    <p>Yorum yapmak için uygulamaya giriş yapmalısınız <a href="/Users/Login">Giriş Yap</a></p>

                }
            

        </div>


      </div>


    </div>

    <div class="col-lg-4">
        <vc:tags-menu></vc:tags-menu>
        <vc:new-post></vc:new-post>

    </div>
    

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.js" ></script>
    <script type="text/javascript">
        $(document).ready(function(){

            $("#BtnYorumKayit").click(function(){

                $.ajax({

                    type:'Post',
                    url:'/Posts/AddComment/',
                    dataType:'json',
                    data:{

                        PostId:$('#PostId').val(),
                        UserName:$('#UserName').val(),
                        Text:$('#Text').val()
                    },
                   success:function(yorum){

                       $("#comments").append(`

                          <div class="my-4 d-flex">

                          <img src="/img/${yorum.avatar}" alt="" class="avatar rounded-circle float-start me-3" >

                           <div>
 
                            <div class="mb-2 d-flex">

                                <h6 class="me-2">${yorum.userName}</h6>
                                <small>${yorum.publishedOn}.ToString("G")</small>

                            </div>
                            <p>${yorum.text}t</p>

                        </div>




                         </div>
                       
                       `);

                         $('#UserName').val('');
                            $('#Text').val('');

                   }
                });

                return false;

            });


        });
    
    
    
    </script>
}
