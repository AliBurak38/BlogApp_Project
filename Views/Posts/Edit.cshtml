
@using System.Security.Claims;
@using NewBlogApp.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model PostsCreateViewModel
@{

    Layout = "_Layout";
}

<form action="Edit" method="post">
<div class="row">
    <div class="col-9">
        <div class="bg-white p-4">

            <h4>Post Güncelleme Formu</h4>

            @if (User.Identity!.IsAuthenticated)
            {
                
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="PostId" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Url" class="form-label"></label>
                        <input asp-for="Url" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label"></label>
                        <textarea asp-for="Content" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    @if (User.FindFirstValue(ClaimTypes.Role) == "Admin")
                    {
                        <div class="mb-3">
                            <label asp-for="IsActive" class="form-label"></label>
                            <input asp-for="IsActive" class="form-check-input" />
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>
                    }

                    <button type="submit" class="btn btn-outline-primary">Post Güncelle</button>



              

            }
            else
            {

                <div class="alert alert-danger">
                    <strong>Hata!</strong> Post güncellemek için giriş yapmalısınız.
                </div>
            }

        </div>
    </div>

    <div class="col-3">
        <div class="bg-white p-4">
            <h4>Etiketler</h4>
            <div class="bg-white p-2">

                @foreach (var tag in @ViewBag.Tags)
                {
                    <div class="form-check">
                            <input class="form-check-input" name="tagIds" type="checkbox" value="@tag.TagId" id="@tag.TagId"
                            @(Model.Tags.Any(t=>t.TagId==tag.TagId) ? "checked": " ")
                        >
                        <label class="form-check-label" for="checkDefault">
                            @tag.Text
                        </label>
                    </div>

                }


            </div>

        </div>
    </div>

  </div>

</form>