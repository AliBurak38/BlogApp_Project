@using NewBlogApp.Entitiy

@model User

@{
    Layout = "_Layout";
}


<div class="row">

    <div class="col-md-2">
        <div class="bg-white p-2">
          
            <img src="/img/@Model.Image" class="img-fluid" alt="" />

        </div>

    </div>

        <div class="col-md-10">
            <div class="bg-white p-2">

            <h5>@Model.UserName</h5>
              

                <hr />

                <div id="Posts">
                  <h5 class="my-4">Yayımlanan Gönderiler @Model.Posts.Count</h5>
                  <ul class="list-group">

                      @foreach(var item in Model.Posts)
                      {
                        <li class="list-group-item"><i class="bi bi-caret-right-fill"><a href="/posts/details/@item.Url">@item.Title</a></i></li>


                      }

                  </ul>
                
                </div>

                <div id="Comments">

                    <h5 class="my-4">Yapılan Yorumlar</h5>
                    <ul class="list-group">

                        @foreach(var comment in Model.Comments)
                        {

                        <li class="list-group-item"><i class="bi bi-chat-text-fill"></i> @comment.Text [@comment.Post?.Title]</li>


                        }


                    </ul>

                </div>
            </div>
            

        </div>



   


    


</div>